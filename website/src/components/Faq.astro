---
// TODO: confirm the calendar-privacy and platform answers with the product team before launch.
const faqs = [
  {
    q: "What does Adapta see in my calendar?",
    a: "Adapta only needs to know when you're busy and when you're free. It reads your calendar to find free slots and adds your planned workouts to it.",
  },
  {
    q: "Do I have to connect my calendar?",
    a: "No. You can mark your free slots by hand on a week view instead.",
  },
  {
    q: "I don't have a race planned. Is Adapta still for me?",
    a: "Yes. Pick a general goal like getting fitter or building your base, and Adapta plans without a race date.",
  },
  {
    q: "What happens if I miss a workout?",
    a: "Tell Adapta why (work, illness or fatigue). It adjusts your next sessions without stacking the missed load onto the rest of your week.",
  },
  {
    q: "What if I only have 20 minutes?",
    a: "Short slots get short sessions like core or mobility, or stay as rest. Your longest slot of the week becomes your key session.",
  },
  {
    q: "Which phones does Adapta run on?",
    a: "Adapta is coming to iOS and Android.",
  },
];
---

<section id="faq" class="bg-white py-16 md:py-28">
  <div class="container-page grid gap-10 md:grid-cols-[1fr_2fr]">
    <div class="reveal">
      <p class="eyebrow">FAQ</p>
      <h2 class="mt-4 text-3xl font-bold sm:text-4xl">Questions, answered.</h2>
    </div>

    <div class="reveal divide-y divide-line">
      {faqs.map((item) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-semibold">
            {item.q}
            <span
              class="grid size-7 shrink-0 place-items-center rounded-full bg-surface text-primary-ink transition group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="mt-3 max-w-prose leading-relaxed text-muted">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  summary::-webkit-details-marker {
    display: none;
  }
</style>
