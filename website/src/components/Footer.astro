---
import Logo from "./Logo.astro";
---

<footer class="border-t border-line py-10">
  <div class="container-page flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
    <Logo />
    <nav aria-label="Legal">
      <ul class="flex gap-6 text-sm text-muted">
        <li><a href="/privacy" class="hover:text-ink">Privacy</a></li>
        <li><a href="/imprint" class="hover:text-ink">Imprint</a></li>
      </ul>
    </nav>
    <p class="text-sm text-muted">© {new Date().getFullYear()} Adapta</p>
  </div>
</footer>
